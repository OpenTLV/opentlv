# Generates the C source amalgamation described in
# docs/development/amalgamation.md from the module registry inventory.
#
#   cmake -DOPENTLV_AMALGAMATION_CONFIG=<file> -DOPENTLV_AMALGAMATION_OUTPUT=<dir>
#         -P cmake/amalgamation/generate.cmake
#
# The configuration file names the registry inventory written by
# opentlv_finalize_modules(), the source and build roots, the version metadata
# and the Query features. The generator copies text and replaces Library
# includes; it never renames, adds or removes code. A source that breaks the
# contract fails generation instead of being rewritten.
cmake_minimum_required(VERSION 3.16)

set(_contract 1)
set(_export_template "${CMAKE_CURRENT_LIST_DIR}/export.h.in")
# C99 standard headers (ISO/IEC 9899:1999, 7.1.2). Angle includes stay in place.
set(_standard_headers assert.h complex.h ctype.h errno.h fenv.h float.h inttypes.h iso646.h
    limits.h locale.h math.h setjmp.h signal.h stdarg.h stdbool.h stddef.h stdint.h stdio.h
    stdlib.h string.h tgmath.h time.h wchar.h wctype.h)
# Generated inputs covered by the contract, besides the per-target export headers.
set(_generated_inputs generated/include/opentlv/core/version.h
    generated/include/opentlv/query/features.h generated/src/version.c)

function(_amalg_fail message)
    message(FATAL_ERROR "opentlv_amalgamation: ${message}")
endfunction()

foreach(_variable IN ITEMS OPENTLV_AMALGAMATION_CONFIG OPENTLV_AMALGAMATION_OUTPUT)
    if(NOT ${_variable})
        _amalg_fail("${_variable} is required")
    endif()
endforeach()
include("${OPENTLV_AMALGAMATION_CONFIG}")
foreach(_variable IN ITEMS SOURCE_DIR BINARY_DIR REGISTRY VERSION REVISION COMMIT BRANCH TAG)
    if("${OPENTLV_AMALGAMATION_${_variable}}" STREQUAL "")
        _amalg_fail("the configuration does not set OPENTLV_AMALGAMATION_${_variable}")
    endif()
endforeach()
include("${OPENTLV_AMALGAMATION_REGISTRY}")
set(_source "${OPENTLV_AMALGAMATION_SOURCE_DIR}")
set(_binary "${OPENTLV_AMALGAMATION_BINARY_DIR}")
set(_output "${OPENTLV_AMALGAMATION_OUTPUT}")
foreach(_root IN ITEMS _source _binary _output)
    get_filename_component(${_root} "${${_root}}" ABSOLUTE)
endforeach()
if(_output STREQUAL _source OR _output STREQUAL _binary)
    _amalg_fail("the output directory must be a dedicated directory: ${_output}")
endif()

# CMake lists split at ';' and treat '[', ']' and '\' specially. Text is
# processed with these four characters replaced by control characters, which
# the inputs must not contain, and restored when the outputs are written.
string(ASCII 1 _escaped_semicolon)
string(ASCII 2 _escaped_open)
string(ASCII 3 _escaped_close)
string(ASCII 4 _escaped_backslash)

function(_amalg_escape text output)
    string(REPLACE "\\" "${_escaped_backslash}" text "${text}")
    string(REPLACE ";" "${_escaped_semicolon}" text "${text}")
    string(REPLACE "[" "${_escaped_open}" text "${text}")
    string(REPLACE "]" "${_escaped_close}" text "${text}")
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

function(_amalg_unescape text output)
    string(REPLACE "${_escaped_semicolon}" ";" text "${text}")
    string(REPLACE "${_escaped_open}" "[" text "${text}")
    string(REPLACE "${_escaped_close}" "]" text "${text}")
    string(REPLACE "${_escaped_backslash}" "\\" text "${text}")
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

function(_amalg_starts_with text prefix output)
    string(LENGTH "${prefix}" length)
    string(SUBSTRING "${text}" 0 ${length} head)
    if(head STREQUAL prefix)
        set(${output} TRUE PARENT_SCOPE)
    else()
        set(${output} FALSE PARENT_SCOPE)
    endif()
endfunction()

# Output paths: relative to the source root, or generated/<path> for inputs
# configured in the build tree. No absolute path reaches an output.
function(_amalg_relative path output)
    _amalg_starts_with("${path}" "${_binary}/generated/" generated)
    _amalg_starts_with("${path}" "${_source}/" source)
    if(generated)
        file(RELATIVE_PATH relative "${_binary}" "${path}")
    elseif(source)
        file(RELATIVE_PATH relative "${_source}" "${path}")
    else()
        _amalg_fail("${path} is outside the source tree and the generated build tree")
    endif()
    set(${output} "${relative}" PARENT_SCOPE)
endfunction()

# --- Registry -----------------------------------------------------------------

set(_composed)
set(_seen)
set(_include_dirs)
set(_registered)
macro(_amalg_register path kind key)
    _amalg_relative("${path}" _relative)
    if(_relative IN_LIST _registered)
        _amalg_fail("${_relative} is registered twice")
    endif()
    _amalg_starts_with("${_relative}" "generated/" _is_generated)
    if(_is_generated AND NOT "${kind}" STREQUAL "export" AND NOT _relative IN_LIST _generated_inputs)
        _amalg_fail("generated input ${_relative} is not covered by the amalgamation contract")
    endif()
    list(APPEND _registered "${_relative}")
    set("_kind_${_relative}" "${kind}")
    set("_target_${_relative}" "${key}")
    set("_path_${_relative}" "${path}")
endmacro()

if(NOT OPENTLV_REGISTRY_MODULES)
    _amalg_fail("the registry lists no modules")
endif()
foreach(_key IN LISTS OPENTLV_REGISTRY_MODULES)
    set(_prefix "OPENTLV_REGISTRY_${_key}_")
    list(APPEND _seen "${_key}")
    if(${_prefix}FACADE)
        continue()
    endif()
    # Registration order is the composition order. It must already be a
    # topological order; the generator does not reorder.
    foreach(_dependency IN LISTS ${_prefix}PUBLIC_DEPS ${_prefix}PRIVATE_DEPS)
        if(NOT _dependency IN_LIST _seen)
            _amalg_fail("${_key} is registered before its dependency ${_dependency}")
        endif()
    endforeach()
    if(NOT ${_prefix}API_MACRO MATCHES "^([A-Z][A-Z0-9_]*)_API$" OR NOT ${_prefix}EXPORT_HEADER)
        _amalg_fail("${_key} has no registered export header")
    endif()
    set(_static_define "${CMAKE_MATCH_1}_STATIC_DEFINE")
    foreach(_definition IN LISTS ${_prefix}COMPILE_DEFINITIONS)
        if(NOT _definition STREQUAL _static_define)
            _amalg_fail("${_key} has the compile definition ${_definition}, which the contract does not cover")
        endif()
    endforeach()
    if(${_prefix}BUILTIN)
        set("_kind_of_${_key}" builtin)
    elseif(NOT ${_prefix}OWNER STREQUAL _key)
        set("_kind_of_${_key}" integration)
    else()
        set("_kind_of_${_key}" module)
    endif()
    list(APPEND _composed "${_key}")
    list(APPEND _include_dirs "${${_prefix}INCLUDE_DIR}")
    _amalg_register("${${_prefix}EXPORT_HEADER}" export "${_key}")
    foreach(_header IN LISTS ${_prefix}PUBLIC_HEADERS)
        _amalg_register("${_header}" public "${_key}")
    endforeach()
    foreach(_header IN LISTS ${_prefix}GENERATED_HEADERS)
        _amalg_register("${_header}" public "${_key}")
    endforeach()
    foreach(_header IN LISTS ${_prefix}PRIVATE_HEADERS)
        _amalg_register("${_header}" private "${_key}")
    endforeach()
    foreach(_file IN LISTS ${_prefix}SOURCES)
        _amalg_register("${_file}" source "${_key}")
    endforeach()
endforeach()
if(NOT _composed)
    _amalg_fail("the registry has no compiled target")
endif()
list(APPEND _include_dirs "${_binary}/generated/include")
list(REMOVE_DUPLICATES _include_dirs)

# --- Inputs -------------------------------------------------------------------

function(_amalg_check_utf8 relative path text)
    # Most inputs are printable ASCII; only the others need the byte check.
    if(text MATCHES "^[\t\n\r -~]*$")
        return()
    endif()
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "(..)" "\\1 " bytes "${hex}")
    string(REGEX MATCHALL "([89a-f][0-9a-f] )+" runs "${bytes}")
    foreach(run IN LISTS runs)
        # Constrain the second byte at the Unicode scalar boundaries: no
        # overlong encodings, UTF-16 surrogates or values above U+10FFFF.
        string(CONCAT scalar
            "(c[2-9a-f]|d[0-9a-f]) [89ab][0-9a-f] |"
            "e0 [ab][0-9a-f] [89ab][0-9a-f] |"
            "(e[1-9abc]|e[ef]) [89ab][0-9a-f] [89ab][0-9a-f] |"
            "ed [89][0-9a-f] [89ab][0-9a-f] |"
            "f0 [9ab][0-9a-f] [89ab][0-9a-f] [89ab][0-9a-f] |"
            "f[123] [89ab][0-9a-f] [89ab][0-9a-f] [89ab][0-9a-f] |"
            "f4 8[0-9a-f] [89ab][0-9a-f] [89ab][0-9a-f] ")
        string(REGEX REPLACE
            "${scalar}"
            "" rest "${run}")
        if(NOT rest STREQUAL "")
            _amalg_fail("${relative} is not UTF-8")
        endif()
    endforeach()
endfunction()

# Reads one composed file with LF line endings and checks the notice and
# source rules that do not need a compiler.
function(_amalg_read relative output)
    get_property(cached GLOBAL PROPERTY "OPENTLV_AMALGAMATION_TEXT_${relative}" SET)
    if(cached)
        get_property(text GLOBAL PROPERTY "OPENTLV_AMALGAMATION_TEXT_${relative}")
        set(${output} "${text}" PARENT_SCOPE)
        return()
    endif()
    set(path "${_path_${relative}}")
    if(_kind_${relative} STREQUAL "export")
        set(OPENTLV_AMALGAMATION_API "${OPENTLV_REGISTRY_${_target_${relative}}_API_MACRO}")
        file(READ "${_export_template}" text)
        string(CONFIGURE "${text}" text @ONLY)
    else()
        if(NOT EXISTS "${path}")
            _amalg_fail("${relative} does not exist")
        endif()
        file(READ "${path}" text)
        _amalg_check_utf8("${relative}" "${path}" "${text}")
    endif()
    string(REPLACE "\r\n" "\n" text "${text}")
    if(text MATCHES "[${_escaped_semicolon}${_escaped_open}${_escaped_close}${_escaped_backslash}]")
        _amalg_fail("${relative} contains control characters")
    endif()
    if(NOT text MATCHES "\n$")
        string(APPEND text "\n")
    endif()
    # REUSE-IgnoreStart
    string(REGEX MATCHALL "SPDX-License-Identifier:[ \t]*[^ \t\n*]*" licenses "${text}")
    # REUSE-IgnoreEnd
    if(NOT licenses)
        _amalg_fail("${relative} has no SPDX-License-Identifier")
    endif()
    foreach(license IN LISTS licenses)
        if(NOT license MATCHES ":[ \t]*MIT$")
            _amalg_fail("${relative}: ${license} is not covered by the amalgamation contract")
        endif()
    endforeach()
    if(text MATCHES "__(FILE|DATE|TIME|COUNTER|BASE_FILE)__")
        _amalg_fail("${relative} uses __${CMAKE_MATCH_1}__, which depends on the build")
    endif()
    set_property(GLOBAL PROPERTY "OPENTLV_AMALGAMATION_TEXT_${relative}" "${text}")
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

# --- Composition --------------------------------------------------------------

# Resolves a quoted include as the compiler does: relative to the including
# file, then the include directories. Only registered headers may be reached.
function(_amalg_resolve including name output)
    get_filename_component(directory "${including}" DIRECTORY)
    foreach(base IN LISTS directory _include_dirs)
        get_filename_component(candidate "${base}/${name}" ABSOLUTE)
        _amalg_starts_with("${candidate}" "${_binary}/generated/" generated)
        _amalg_starts_with("${candidate}" "${_source}/" source)
        set(relative)
        if(generated OR source)
            _amalg_relative("${candidate}" relative)
        endif()
        if(relative AND relative IN_LIST _registered)
            set(${output} "${relative}" PARENT_SCOPE)
            return()
        endif()
        if(EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
            _amalg_fail("#include \"${name}\" reaches ${candidate}, which no composed target registers")
        endif()
    endforeach()
    _amalg_fail("#include \"${name}\" does not resolve to a registered header")
endfunction()

function(_amalg_append phase text)
    set_property(GLOBAL APPEND_STRING PROPERTY OPENTLV_AMALGAMATION_${phase} "${text}")
endfunction()

# Emits one file depth-first: a quoted Library include is replaced by the
# header's text at its first inclusion and removed at later ones. Phase "h"
# composes opentlv.h from public headers; phase "c" composes opentlv.c from
# sources and private headers. owner is the owning module of the source.
function(_amalg_emit relative phase owner from)
    # Boundaries hold for every inclusion, not only the first.
    set(kind "${_kind_${relative}}")
    set(key "${_target_${relative}}")
    if(phase STREQUAL "h" AND NOT kind MATCHES "^(public|export)$")
        _amalg_fail("public header ${from} includes ${kind} file ${relative}")
    endif()
    if(kind STREQUAL "private" AND NOT OPENTLV_REGISTRY_${key}_OWNER STREQUAL owner)
        _amalg_fail("${from} of module ${owner} includes ${relative}, private to module ${OPENTLV_REGISTRY_${key}_OWNER}")
    endif()
    if(kind STREQUAL "source" AND NOT from STREQUAL "")
        _amalg_fail("${from} includes the source file ${relative}")
    endif()
    get_property(emitted GLOBAL PROPERTY OPENTLV_AMALGAMATION_EMITTED)
    if(relative IN_LIST emitted)
        return()
    endif()
    if(phase STREQUAL "c" AND kind MATCHES "^(public|export)$")
        _amalg_fail("${from} includes ${relative}, which no public header of opentlv.h reaches")
    endif()
    set_property(GLOBAL APPEND PROPERTY OPENTLV_AMALGAMATION_EMITTED "${relative}")

    _amalg_read("${relative}" text)
    string(SHA256 digest "${text}")
    set_property(GLOBAL APPEND PROPERTY OPENTLV_AMALGAMATION_INPUTS "${relative}|${digest}")
    string(REGEX MATCHALL "(^|\n)[ \t]*(//|/\\*|\\*)[ \t]*Copyright[^\n]*" copyrights "${text}")
    foreach(copyright IN LISTS copyrights)
        string(REGEX REPLACE "^\n?[ \t]*(//|/\\*|\\*)[ \t]*" "" copyright "${copyright}")
        string(STRIP "${copyright}" copyright)
        if(copyright MATCHES "^(.*)\\*/$")
            string(STRIP "${CMAKE_MATCH_1}" copyright)
        endif()
        set_property(GLOBAL APPEND PROPERTY OPENTLV_AMALGAMATION_COPYRIGHTS_${phase} "${copyright}")
    endforeach()

    set(header FALSE)
    set(base 0)
    if(relative MATCHES "\\.h$")
        set(header TRUE)
        set(base 1)
    endif()
    _amalg_escape("${text}" text)
    string(REGEX REPLACE "\n$" "" text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(chunk "/* ==== begin ${relative} ==== */\n")
    set(depth 0)
    set(directives 0)
    set(guard)
    set(closed FALSE)
    set(defines)
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "^[ \t]*#[ \t]*([a-z]*)(.*)$")
            string(APPEND chunk "${line}\n")
            continue()
        endif()
        set(directive "${CMAKE_MATCH_1}")
        set(rest "${CMAKE_MATCH_2}")
        math(EXPR directives "${directives} + 1")
        if(closed)
            _amalg_fail("${relative} has a directive after its include guard")
        endif()
        if(header AND directives EQUAL 1)
            if(NOT directive STREQUAL "ifndef" OR NOT rest MATCHES "^[ \t]+([A-Za-z_][A-Za-z0-9_]*)[ \t]*$")
                _amalg_fail("${relative} does not start with an include guard")
            endif()
            set(guard "${CMAKE_MATCH_1}")
        elseif(header AND directives EQUAL 2)
            if(NOT directive STREQUAL "define" OR NOT rest MATCHES "^[ \t]+${guard}[ \t]*$")
                _amalg_fail("${relative} does not define its include guard ${guard}")
            endif()
            get_property(guards GLOBAL PROPERTY OPENTLV_AMALGAMATION_GUARDS)
            if(guard IN_LIST guards)
                _amalg_fail("${relative} reuses the include guard ${guard}")
            endif()
            set_property(GLOBAL APPEND PROPERTY OPENTLV_AMALGAMATION_GUARDS "${guard}")
        endif()
        if(directive STREQUAL "include")
            if(rest MATCHES "^[ \t]*\"([^\"]+)\"[ \t]*(//.*|/\\*.*)?$")
                set(name "${CMAKE_MATCH_1}")
                if(NOT depth EQUAL base)
                    _amalg_fail("${relative} includes \"${name}\" conditionally")
                endif()
                _amalg_resolve("${_path_${relative}}" "${name}" included)
                _amalg_append(${phase} "${chunk}")
                set(chunk)
                _amalg_emit("${included}" ${phase} "${owner}" "${relative}")
                continue()
            elseif(rest MATCHES "^[ \t]*<([^>]+)>")
                if(NOT CMAKE_MATCH_1 IN_LIST _standard_headers)
                    _amalg_fail("${relative} includes <${CMAKE_MATCH_1}>, which is not a C99 standard header")
                endif()
            else()
                _amalg_fail("${relative} has an include that is not a literal header name")
            endif()
        elseif(directive MATCHES "^if(n?def)?$")
            math(EXPR depth "${depth} + 1")
        elseif(directive STREQUAL "endif")
            math(EXPR depth "${depth} - 1")
            if(depth LESS 0)
                _amalg_fail("${relative} has an unbalanced #endif")
            endif()
            if(header AND depth EQUAL 0)
                set(closed TRUE)
            endif()
        elseif(directive STREQUAL "define" AND NOT header)
            if(rest MATCHES "^[ \t]+([A-Za-z_][A-Za-z0-9_]*)")
                list(APPEND defines "${CMAKE_MATCH_1}")
            endif()
        elseif(directive STREQUAL "undef")
            if(rest MATCHES "^[ \t]+([A-Za-z_][A-Za-z0-9_]*)" AND defines)
                list(REMOVE_ITEM defines "${CMAKE_MATCH_1}")
            endif()
        elseif(directive STREQUAL "pragma" AND rest MATCHES "^[ \t]+once")
            _amalg_fail("${relative} uses #pragma once")
        endif()
        string(APPEND chunk "${line}\n")
    endforeach()
    if(NOT depth EQUAL 0 OR (header AND NOT closed))
        _amalg_fail("${relative} has unbalanced conditionals or no closing include guard")
    endif()
    if(defines)
        list(REMOVE_DUPLICATES defines)
        string(REPLACE ";" ", " defines "${defines}")
        _amalg_fail("${relative} does not #undef the macros it defines: ${defines}")
    endif()
    string(APPEND chunk "/* ==== end ${relative} ==== */\n")
    _amalg_append(${phase} "${chunk}")
endfunction()

foreach(_key IN LISTS _composed)
    foreach(_header IN LISTS OPENTLV_REGISTRY_${_key}_PUBLIC_HEADERS OPENTLV_REGISTRY_${_key}_GENERATED_HEADERS)
        _amalg_relative("${_header}" _relative)
        if(_relative MATCHES "\\.h$")
            _amalg_emit("${_relative}" h "${OPENTLV_REGISTRY_${_key}_OWNER}" "")
        endif()
    endforeach()
endforeach()
get_property(_public GLOBAL PROPERTY OPENTLV_AMALGAMATION_EMITTED)
foreach(_key IN LISTS _composed)
    foreach(_file IN LISTS OPENTLV_REGISTRY_${_key}_SOURCES)
        _amalg_relative("${_file}" _relative)
        _amalg_emit("${_relative}" c "${OPENTLV_REGISTRY_${_key}_OWNER}" "")
    endforeach()
endforeach()

# --- Outputs ------------------------------------------------------------------

# The license identifier and the distinct copyright lines of the file's own
# inputs in first-seen order, then the generation notice.
function(_amalg_prologue phase output)
    get_property(copyrights GLOBAL PROPERTY OPENTLV_AMALGAMATION_COPYRIGHTS_${phase})
    list(REMOVE_DUPLICATES copyrights)
    # REUSE-IgnoreStart
    set(prologue "// SPDX-License-Identifier: MIT\n")
    # REUSE-IgnoreEnd
    foreach(copyright IN LISTS copyrights)
        string(APPEND prologue "// ${copyright}\n")
    endforeach()
    string(APPEND prologue "//\n"
        "// Generated by the OpenTLV C source amalgamation (contract ${_contract}) from\n"
        "// OpenTLV ${OPENTLV_AMALGAMATION_VERSION}, commit ${OPENTLV_AMALGAMATION_COMMIT}.\n"
        "// Do not edit: change the modular sources and run the opentlv_amalgamation\n"
        "// build target again.\n\n")
    set(${output} "${prologue}" PARENT_SCOPE)
endfunction()
_amalg_prologue(h _header_prologue)
_amalg_prologue(c _source_prologue)
get_property(_header_text GLOBAL PROPERTY OPENTLV_AMALGAMATION_h)
get_property(_source_text GLOBAL PROPERTY OPENTLV_AMALGAMATION_c)
_amalg_unescape("${_header_prologue}${_header_text}" _header_text)
_amalg_unescape("${_source_prologue}#include \"opentlv.h\"\n\n${_source_text}" _source_text)

function(_amalg_json_string value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_amalg_json_paths output indent)
    set(items)
    foreach(path IN LISTS ARGN)
        _amalg_relative("${path}" relative)
        _amalg_json_string("${relative}" relative)
        list(APPEND items "${indent}  ${relative}")
    endforeach()
    if(items)
        string(REPLACE ";" ",\n" items "${items}")
        set(${output} "[\n${items}\n${indent}]" PARENT_SCOPE)
    else()
        set(${output} "[]" PARENT_SCOPE)
    endif()
endfunction()

function(_amalg_json_bool value output)
    if(value)
        set(${output} true PARENT_SCOPE)
    else()
        set(${output} false PARENT_SCOPE)
    endif()
endfunction()

if(NOT OPENTLV_AMALGAMATION_REVISION MATCHES "^[0-9]+$")
    _amalg_fail("the revision ${OPENTLV_AMALGAMATION_REVISION} is not a number")
endif()
set(_targets)
set(_separator "")
foreach(_key IN LISTS _composed)
    set(_prefix "OPENTLV_REGISTRY_${_key}_")
    _amalg_json_string("${${_prefix}EXPORT_NAME}" _name)
    _amalg_json_paths(_headers "      " ${${_prefix}PUBLIC_HEADERS} ${${_prefix}GENERATED_HEADERS})
    _amalg_json_paths(_sources "      " ${${_prefix}SOURCES})
    string(CONCAT _targets "${_targets}" "${_separator}"
        "    {\n      \"export_name\": ${_name},\n      \"key\": \"${_key}\",\n"
        "      \"kind\": \"${_kind_of_${_key}}\",\n      \"public_headers\": ${_headers},\n"
        "      \"sources\": ${_sources}\n    }")
    set(_separator ",\n")
endforeach()
get_property(_inputs GLOBAL PROPERTY OPENTLV_AMALGAMATION_INPUTS)
set(_input_items)
set(_separator "")
foreach(_input IN LISTS _inputs)
    string(REPLACE "|" ";" _input "${_input}")
    list(GET _input 0 _path)
    list(GET _input 1 _digest)
    _amalg_json_string("${_path}" _path)
    string(CONCAT _input_items "${_input_items}" "${_separator}"
        "    {\n      \"path\": ${_path},\n      \"sha256\": \"${_digest}\"\n    }")
    set(_separator ",\n")
endforeach()
_amalg_json_bool("${OPENTLV_AMALGAMATION_QUERY_FRONTEND}" _frontend)
_amalg_json_bool("${OPENTLV_AMALGAMATION_QUERY_SET_OPERATIONS}" _set_operations)
foreach(_field IN ITEMS VERSION COMMIT BRANCH TAG)
    _amalg_json_string("${OPENTLV_AMALGAMATION_${_field}}" _json_${_field})
endforeach()
string(CONCAT _metadata "{\n"
    "  \"branch\": ${_json_BRANCH},\n"
    "  \"commit\": ${_json_COMMIT},\n"
    "  \"configuration\": {\n"
    "    \"query_frontend\": ${_frontend},\n"
    "    \"query_set_operations\": ${_set_operations}\n"
    "  },\n"
    "  \"inputs\": [\n${_input_items}\n  ],\n"
    "  \"library\": \"OpenTLV\",\n"
    "  \"revision\": ${OPENTLV_AMALGAMATION_REVISION},\n"
    "  \"schema\": ${_contract},\n"
    "  \"tag\": ${_json_TAG},\n"
    "  \"targets\": [\n${_targets}\n  ],\n"
    "  \"version\": ${_json_VERSION}\n"
    "}\n")

# The include/ tree: every installed public C and C++ header unchanged, with
# the export headers in their portable form.
set(_tree)
macro(_amalg_tree_add path root)
    file(RELATIVE_PATH _tree_path "${root}" "${path}")
    if(_tree_path IN_LIST _tree)
        _amalg_fail("include/${_tree_path} is registered twice")
    endif()
    list(APPEND _tree "${_tree_path}")
    set("_tree_source_${_tree_path}" "${path}")
endmacro()
foreach(_key IN LISTS OPENTLV_REGISTRY_MODULES)
    set(_prefix "OPENTLV_REGISTRY_${_key}_")
    foreach(_header IN LISTS ${_prefix}PUBLIC_HEADERS ${_prefix}CXX_HEADERS)
        _amalg_tree_add("${_header}" "${${_prefix}INCLUDE_DIR}")
    endforeach()
    foreach(_header IN LISTS ${_prefix}GENERATED_HEADERS ${_prefix}EXPORT_HEADER)
        _amalg_tree_add("${_header}" "${_binary}/generated/include")
    endforeach()
endforeach()
foreach(_header IN LISTS OPENTLV_REGISTRY_AGGREGATE_HEADERS)
    _amalg_tree_add("${_header}" "${_source}/include")
endforeach()
list(SORT _tree)
set(_tree_text)
foreach(_tree_path IN LISTS _tree)
    if(_tree_path MATCHES "^\\.\\./" OR IS_ABSOLUTE "${_tree_path}")
        _amalg_fail("${_tree_source_${_tree_path}} is outside its include directory")
    endif()
    _amalg_relative("${_tree_source_${_tree_path}}" _relative)
    if(_relative IN_LIST _registered)
        _amalg_read("${_relative}" _text)
    else()
        if(NOT EXISTS "${_tree_source_${_tree_path}}")
            _amalg_fail("${_relative} does not exist")
        endif()
        file(READ "${_tree_source_${_tree_path}}" _text)
        string(REPLACE "\r\n" "\n" _text "${_text}")
    endif()
    set("_tree_text_${_tree_path}" "${_text}")
endforeach()

foreach(_text IN ITEMS _header_text _source_text _metadata)
    foreach(_root IN ITEMS _source _binary)
        string(FIND "${${_text}}" "${${_root}}" _found)
        if(NOT _found EQUAL -1)
            _amalg_fail("an output contains the absolute path ${${_root}}")
        endif()
    endforeach()
endforeach()

# file(WRITE) translates newlines on Windows. configure_file() with LF
# newlines substitutes the text verbatim, without expanding it again, and ends
# its last line itself.
set(_content_template "${_binary}/opentlv-amalgamation-content.in")
file(WRITE "${_content_template}" "@OPENTLV_AMALGAMATION_CONTENT@")
function(_amalg_write path text)
    string(REGEX REPLACE "\n$" "" OPENTLV_AMALGAMATION_CONTENT "${text}")
    configure_file("${_content_template}" "${path}" @ONLY NEWLINE_STYLE UNIX)
endfunction()
file(REMOVE_RECURSE "${_output}/include")
_amalg_write("${_output}/opentlv.h" "${_header_text}")
_amalg_write("${_output}/opentlv.c" "${_source_text}")
_amalg_write("${_output}/opentlv-amalgamation.json" "${_metadata}")
foreach(_tree_path IN LISTS _tree)
    _amalg_write("${_output}/include/${_tree_path}" "${_tree_text_${_tree_path}}")
endforeach()
file(REMOVE "${_content_template}")
list(LENGTH _composed _target_count)
list(LENGTH _inputs _input_count)
list(LENGTH _tree _tree_count)
message(STATUS "OpenTLV amalgamation: ${_target_count} targets, ${_input_count} inputs, "
    "${_tree_count} include/ headers in ${_output}")
