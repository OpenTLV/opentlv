@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/OpenTLVModules.cmake")

# NAMES OpenTLV changes the filename search, not the requested package name.
set(_OpenTLV_package "${CMAKE_FIND_PACKAGE_NAME}")
if(NOT _OpenTLV_package)
    set(_OpenTLV_package OpenTLV)
endif()
set(_OpenTLV_version "@OpenTLV_VERSION@")
set(${_OpenTLV_package}_FOUND TRUE)
unset(${_OpenTLV_package}_NOT_FOUND_MESSAGE)
get_filename_component(_OpenTLV_package_dir "${CMAKE_CURRENT_LIST_DIR}" REALPATH)

# Redirects must select this config even on a version mismatch: otherwise CMake
# can fall through to an older installed config that blindly reuses our aliases.
# Apply the ordinary package version policy here before loading any targets.
function(_OpenTLV_check_version output)
    set(PACKAGE_FIND_NAME "${_OpenTLV_package}")
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
    set(PACKAGE_VERSION_EXACT FALSE)
    set(PACKAGE_VERSION_UNSUITABLE FALSE)
    foreach(_field IN ITEMS VERSION VERSION_MAJOR VERSION_MINOR VERSION_PATCH
            VERSION_TWEAK VERSION_COUNT VERSION_RANGE VERSION_RANGE_MIN VERSION_RANGE_MAX
            VERSION_MIN VERSION_MAX)
        set(PACKAGE_FIND_${_field} "${${_OpenTLV_package}_FIND_${_field}}")
    endforeach()
    include("${CMAKE_CURRENT_LIST_DIR}/OpenTLVConfigVersion.cmake")
    if(PACKAGE_VERSION_UNSUITABLE OR NOT PACKAGE_VERSION_COMPATIBLE OR
       (${_OpenTLV_package}_FIND_VERSION_EXACT AND NOT PACKAGE_VERSION_EXACT))
        set(${output} FALSE PARENT_SCOPE)
    else()
        set(${output} TRUE PARENT_SCOPE)
    endif()
endfunction()
# Ordinary package lookup already evaluated the version file. Only forwarding
# configs need this second-stage check; avoid duplicate ExactVersion warnings.
if(_OpenTLV_redirect_check AND ${_OpenTLV_package}_FIND_VERSION)
    _OpenTLV_check_version(_OpenTLV_version_matches)
    if(NOT _OpenTLV_version_matches)
        set(${_OpenTLV_package}_FOUND FALSE)
        set(${_OpenTLV_package}_NOT_FOUND_MESSAGE
            "OpenTLV ${_OpenTLV_version} does not match requested version ${${_OpenTLV_package}_FIND_VERSION}")
        return()
    endif()
endif()

# Never report one installation's metadata while retaining another's targets.
# Build-tree configurations may reuse their own embedded aliases.
foreach(_component IN LISTS _OpenTLV_components ITEMS tlv)
    if(TARGET OpenTLV::${_component})
        get_target_property(_OpenTLV_origin OpenTLV::${_component} INTERFACE_OPENTLV_PACKAGE_DIR)
        if(NOT _OpenTLV_origin STREQUAL _OpenTLV_package_dir)
            set(${_OpenTLV_package}_FOUND FALSE)
            set(${_OpenTLV_package}_NOT_FOUND_MESSAGE
                "OpenTLV target OpenTLV::${_component} already belongs to a different Library: ${_OpenTLV_origin}; requested ${_OpenTLV_package_dir}")
            return()
        endif()
    endif()
endforeach()

# Validate all required components before importing anything. A failed optional
# find_package may be followed by FetchContent's source fallback.
set(_OpenTLV_requested "${${_OpenTLV_package}_FIND_COMPONENTS}")
if(NOT _OpenTLV_requested)
    set(_OpenTLV_requested ${_OpenTLV_components})
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/OpenTLVTargets.cmake" OR
       TARGET OpenTLV::tlv)
        list(APPEND _OpenTLV_requested tlv)
    endif()
endif()
foreach(_component IN LISTS _OpenTLV_requested)
    set(_OpenTLV_available FALSE)
    if(_component IN_LIST _OpenTLV_components)
        set(_OpenTLV_available TRUE)
    elseif(_component STREQUAL "tlv" AND
           (EXISTS "${CMAKE_CURRENT_LIST_DIR}/OpenTLVTargets.cmake" OR TARGET OpenTLV::tlv))
        set(_OpenTLV_available TRUE)
    endif()
    set(${_OpenTLV_package}_${_component}_FOUND ${_OpenTLV_available})
    if(NOT _OpenTLV_available AND ${_OpenTLV_package}_FIND_REQUIRED_${_component})
        set(${_OpenTLV_package}_FOUND FALSE)
        set(${_OpenTLV_package}_NOT_FOUND_MESSAGE "Unknown or unavailable OpenTLV component: ${_component}")
    endif()
endforeach()
if(NOT ${_OpenTLV_package}_FOUND)
    return()
endif()

function(_OpenTLV_load_component component)
    if(TARGET OpenTLV::${component})
        return()
    endif()
    foreach(dependency IN LISTS _OpenTLV_deps_${component})
        _OpenTLV_load_component("${dependency}")
    endforeach()
    include("${CMAKE_CURRENT_LIST_DIR}/OpenTLV-${_OpenTLV_key_${component}}Targets.cmake")
    set_property(TARGET OpenTLV::${component} PROPERTY INTERFACE_OPENTLV_PACKAGE_DIR "${_OpenTLV_package_dir}")
endfunction()

foreach(_component IN LISTS _OpenTLV_requested)
    if(_component IN_LIST _OpenTLV_components)
        _OpenTLV_load_component("${_component}")
    elseif(_component STREQUAL "tlv" AND ${_OpenTLV_package}_tlv_FOUND AND NOT TARGET OpenTLV::tlv)
        foreach(_dependency IN LISTS _OpenTLV_components)
            _OpenTLV_load_component("${_dependency}")
        endforeach()
        include("${CMAKE_CURRENT_LIST_DIR}/OpenTLVTargets.cmake")
        set_property(TARGET OpenTLV::tlv PROPERTY INTERFACE_OPENTLV_PACKAGE_DIR "${_OpenTLV_package_dir}")
    endif()
endforeach()
set(OpenTLV_VERSION "${_OpenTLV_version}")
set(${_OpenTLV_package}_VERSION "${_OpenTLV_version}")
