@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/OpenTLVModules.cmake")

# Keep no-component discovery compatible with the existing distribution.
if((NOT OpenTLV_FIND_COMPONENTS OR "tlv" IN_LIST OpenTLV_FIND_COMPONENTS OR
    "tlv++" IN_LIST OpenTLV_FIND_COMPONENTS) AND
   EXISTS "${CMAKE_CURRENT_LIST_DIR}/OpenTLVTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/OpenTLVTargets.cmake")
    foreach(_component IN ITEMS tlv tlv++)
        if(TARGET OpenTLV::${_component})
            set(OpenTLV_${_component}_FOUND TRUE)
        endif()
    endforeach()
endif()

function(_OpenTLV_load_component component)
    if(TARGET OpenTLV::${component})
        return()
    endif()
    foreach(dependency IN LISTS _OpenTLV_deps_${component})
        _OpenTLV_load_component("${dependency}")
    endforeach()
    include("${CMAKE_CURRENT_LIST_DIR}/OpenTLV-${_OpenTLV_key_${component}}Targets.cmake")
endfunction()

set(_OpenTLV_requested "${OpenTLV_FIND_COMPONENTS}")
if(NOT _OpenTLV_requested)
    set(_OpenTLV_requested "${_OpenTLV_components}")
endif()
foreach(_component IN LISTS _OpenTLV_requested)
    # Validate against the registry before using a component in a filename.
    if(_component IN_LIST _OpenTLV_components)
        _OpenTLV_load_component("${_component}")
        set(OpenTLV_${_component}_FOUND TRUE)
    elseif(NOT TARGET OpenTLV::${_component})
        set(OpenTLV_${_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(OpenTLV)
