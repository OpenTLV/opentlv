include_guard(GLOBAL)
include(GNUInstallDirs)
include(GenerateExportHeader)

# Internal keys are stable; EXPORT_NAME is an explicit public naming decision.
# This helper is for extracted modules, not aliases to the legacy monolith.
function(opentlv_add_module key)
    cmake_parse_arguments(M "FACADE" "OWNER;EXPORT_NAME;INCLUDE_DIR;CONSUMER"
        "SOURCES;PUBLIC_HEADERS;PRIVATE_HEADERS;PUBLIC_DEPS;PRIVATE_DEPS;PUBLIC_SYMBOLS;OWNER_SYMBOLS" ${ARGN})
    if(M_UNPARSED_ARGUMENTS OR NOT key MATCHES "^[a-z][a-z0-9-]*$" OR
       NOT M_EXPORT_NAME MATCHES "^[A-Za-z][A-Za-z0-9_+-]*$" OR NOT M_CONSUMER OR
       NOT M_INCLUDE_DIR OR NOT M_PUBLIC_HEADERS)
        message(FATAL_ERROR "Module ${key}: invalid arguments, EXPORT_NAME or missing CONSUMER")
    endif()
    get_property(keys GLOBAL PROPERTY OPENTLV_MODULES)
    if(key IN_LIST keys)
        message(FATAL_ERROR "Duplicate module ${key}")
    endif()
    if(NOT M_OWNER)
        set(M_OWNER "${key}")
    endif()
    string(REPLACE "-" "_" target "opentlv_${key}")
    string(TOUPPER "${target}" prefix)
    get_filename_component(M_INCLUDE_DIR "${M_INCLUDE_DIR}" ABSOLUTE)
    get_filename_component(M_CONSUMER "${M_CONSUMER}" ABSOLUTE)
    foreach(field IN ITEMS SOURCES PUBLIC_HEADERS PRIVATE_HEADERS)
        set(paths)
        foreach(path IN LISTS M_${field})
            get_filename_component(path "${path}" ABSOLUTE)
            list(APPEND paths "${path}")
        endforeach()
        set(M_${field} "${paths}")
    endforeach()
    if(M_FACADE)
        if(M_SOURCES OR M_PRIVATE_DEPS OR M_PUBLIC_SYMBOLS OR M_OWNER_SYMBOLS)
            message(FATAL_ERROR "Facade ${key}: only headers and public dependencies are allowed")
        endif()
        add_library(${target} INTERFACE)
        set(scope INTERFACE)
        target_compile_features(${target} INTERFACE cxx_std_11)
    else()
        if(NOT M_SOURCES OR NOT M_PUBLIC_SYMBOLS)
            message(FATAL_ERROR "Module ${key}: declare sources and public symbols")
        endif()
        set(kind STATIC)
        if(OPENTLV_BUILD_SHARED_LIBS)
            set(kind SHARED)
        endif()
        add_library(${target} ${kind} ${M_SOURCES})
        set(scope PUBLIC)
        set_target_properties(${target} PROPERTIES C_VISIBILITY_PRESET hidden
            CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON
            WINDOWS_EXPORT_ALL_SYMBOLS OFF)
        # Dependencies live beside the module after a relocatable installation.
        # An application RUNPATH alone does not locate indirect ELF dependencies.
        if(NOT CMAKE_INSTALL_RPATH)
            if(APPLE)
                set_property(TARGET ${target} PROPERTY INSTALL_RPATH "@loader_path")
            elseif(UNIX)
                set_property(TARGET ${target} PROPERTY INSTALL_RPATH "$ORIGIN")
            endif()
        endif()
        target_compile_features(${target} PUBLIC c_std_99)
        set(export_header "${OpenTLV_BINARY_DIR}/generated/include/tlv/${key}/export.h")
        generate_export_header(${target} BASE_NAME ${prefix}
            EXPORT_MACRO_NAME ${prefix}_API EXPORT_FILE_NAME "${export_header}")
        if(NOT OPENTLV_BUILD_SHARED_LIBS)
            target_compile_definitions(${target} PUBLIC ${prefix}_STATIC_DEFINE)
        endif()
        install(FILES "${export_header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/tlv/${key}")
        if(COMMAND opentlv_configure_compiler)
            opentlv_configure_compiler(${target})
        endif()
    endif()
    target_include_directories(${target} ${scope}
        "$<BUILD_INTERFACE:${M_INCLUDE_DIR}>"
        "$<BUILD_INTERFACE:${OpenTLV_BINARY_DIR}/generated/include>"
        "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>")
    set_target_properties(${target} PROPERTIES EXPORT_NAME "${M_EXPORT_NAME}")
    add_library(OpenTLV::${M_EXPORT_NAME} ALIAS ${target})
    set_property(GLOBAL APPEND PROPERTY OPENTLV_MODULES "${key}")
    set_property(GLOBAL PROPERTY OPENTLV_MODULE_${key} "${target}")
    foreach(field IN ITEMS OWNER EXPORT_NAME INCLUDE_DIR CONSUMER SOURCES PUBLIC_HEADERS
            PRIVATE_HEADERS PUBLIC_DEPS PRIVATE_DEPS PUBLIC_SYMBOLS OWNER_SYMBOLS FACADE)
        # INTERFACE_ custom properties also work on interface targets in CMake 3.16.
        set_property(TARGET ${target} PROPERTY INTERFACE_OPENTLV_${field} "${M_${field}}")
    endforeach()
    foreach(header IN LISTS M_PUBLIC_HEADERS)
        file(RELATIVE_PATH relative "${M_INCLUDE_DIR}" "${header}")
        if(relative MATCHES "^\\.\\." OR IS_ABSOLUTE "${relative}")
            message(FATAL_ERROR "${key}: public header outside INCLUDE_DIR: ${header}")
        endif()
        get_filename_component(directory "${relative}" DIRECTORY)
        install(FILES "${header}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/${directory}")
    endforeach()
    install(TARGETS ${target} EXPORT OpenTLV-${key}Targets
        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
    install(EXPORT OpenTLV-${key}Targets NAMESPACE OpenTLV::
        DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OpenTLV")
endfunction()

function(_opentlv_visit_module key trail)
    if(key IN_LIST trail)
        message(FATAL_ERROR "Module dependency cycle: ${trail};${key}")
    endif()
    get_property(target GLOBAL PROPERTY OPENTLV_MODULE_${key})
    if(NOT target)
        message(FATAL_ERROR "Undeclared module dependency ${key}")
    endif()
    list(APPEND trail "${key}")
    foreach(scope IN ITEMS PUBLIC PRIVATE)
        get_target_property(deps ${target} INTERFACE_OPENTLV_${scope}_DEPS)
        foreach(dep IN LISTS deps)
            _opentlv_visit_module("${dep}" "${trail}")
        endforeach()
    endforeach()
endfunction()

function(_opentlv_json_list output)
    set(items)
    foreach(value IN LISTS ARGN)
        string(REPLACE "\\" "/" value "${value}")
        string(REPLACE "\"" "\\\"" value "${value}")
        list(APPEND items "\"${value}\"")
    endforeach()
    string(JOIN "," items ${items})
    set(${output} "[${items}]" PARENT_SCOPE)
endfunction()

function(_opentlv_check_registered_libraries directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        get_target_property(key ${target} INTERFACE_OPENTLV_OWNER)
        if(type MATCHES "^(STATIC|SHARED|OBJECT|INTERFACE)_LIBRARY$" AND NOT key AND
           NOT target STREQUAL "tlv" AND NOT target STREQUAL "tlv++")
            message(FATAL_ERROR "Unregistered module library ${target}; use opentlv_add_module")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        _opentlv_check_registered_libraries("${child}")
    endforeach()
endfunction()

# Call once after all registrations and before package configuration.
function(opentlv_finalize_modules)
    # Production library roots only: test/benchmark third-party targets are not modules.
    foreach(directory IN ITEMS tlv tlv++)
        if(EXISTS "${OpenTLV_SOURCE_DIR}/${directory}/CMakeLists.txt")
            if(directory STREQUAL "tlv" OR OPENTLV_BUILD_CXX)
                _opentlv_check_registered_libraries("${OpenTLV_SOURCE_DIR}/${directory}")
            endif()
        endif()
    endforeach()
    get_property(keys GLOBAL PROPERTY OPENTLV_MODULES)
    set(registry "# Generated module component registry.\nset(_OpenTLV_components)\n")
    set(entries)
    foreach(key IN LISTS keys)
        _opentlv_visit_module("${key}" "")
        get_property(target GLOBAL PROPERTY OPENTLV_MODULE_${key})
        get_target_property(facade ${target} INTERFACE_OPENTLV_FACADE)
        get_target_property(export_name ${target} INTERFACE_OPENTLV_EXPORT_NAME)
        get_target_property(owner ${target} INTERFACE_OPENTLV_OWNER)
        if(NOT facade)
            get_target_property(actual_sources ${target} SOURCES)
            get_target_property(declared_sources ${target} INTERFACE_OPENTLV_SOURCES)
            if(NOT actual_sources STREQUAL declared_sources)
                message(FATAL_ERROR "${key}: declare all sources with opentlv_add_module")
            endif()
        endif()
        if(NOT owner IN_LIST keys)
            message(FATAL_ERROR "${key}: missing owning module ${owner}")
        endif()
        set(existing)
        if(NOT facade)
            get_target_property(existing ${target} LINK_LIBRARIES)
        endif()
        get_target_property(interface ${target} INTERFACE_LINK_LIBRARIES)
        if(existing OR interface)
            message(FATAL_ERROR "${key}: declare links with PUBLIC_DEPS or PRIVATE_DEPS")
        endif()
        set(dependency_names)
        set(all_deps)
        foreach(scope IN ITEMS PUBLIC PRIVATE)
            get_target_property(deps ${target} INTERFACE_OPENTLV_${scope}_DEPS)
            foreach(dep IN LISTS deps)
                list(APPEND all_deps "${dep}")
                get_property(dependency GLOBAL PROPERTY OPENTLV_MODULE_${dep})
                get_target_property(dep_name ${dependency} INTERFACE_OPENTLV_EXPORT_NAME)
                list(APPEND dependency_names "${dep_name}")
                if(facade)
                    target_link_libraries(${target} INTERFACE ${dependency})
                else()
                    target_link_libraries(${target} ${scope} ${dependency})
                endif()
            endforeach()
        endforeach()
        if(NOT owner STREQUAL key AND NOT owner IN_LIST all_deps)
            message(FATAL_ERROR "${key}: integration must directly depend on owner ${owner}")
        endif()
        string(APPEND registry "list(APPEND _OpenTLV_components \"${export_name}\")\n"
            "set(_OpenTLV_key_${export_name} \"${key}\")\n"
            "set(_OpenTLV_deps_${export_name} \"${dependency_names}\")\n")
        set(entry "\"key\":\"${key}\",\"target\":\"${target}\"")
        foreach(field IN ITEMS OWNER EXPORT_NAME INCLUDE_DIR CONSUMER SOURCES PUBLIC_HEADERS
                PRIVATE_HEADERS PUBLIC_DEPS PRIVATE_DEPS PUBLIC_SYMBOLS OWNER_SYMBOLS FACADE)
            get_target_property(value ${target} INTERFACE_OPENTLV_${field})
            _opentlv_json_list(value ${value})
            string(TOLOWER "${field}" field)
            string(APPEND entry ",\"${field}\":${value}")
        endforeach()
        if(NOT facade)
            string(APPEND entry ",\"library\":\"$<TARGET_FILE:${target}>\"")
        endif()
        list(APPEND entries "{${entry}}")
    endforeach()
    string(JOIN ",\n" entries ${entries})
    file(GENERATE OUTPUT "${OpenTLV_BINARY_DIR}/modules-$<CONFIG>.json" CONTENT "[${entries}]\n")
    file(WRITE "${OpenTLV_BINARY_DIR}/OpenTLVModules.cmake" "${registry}")
    install(FILES "${OpenTLV_BINARY_DIR}/OpenTLVModules.cmake"
        DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/OpenTLV")
endfunction()

# A scenario belongs to one module/integration; extra links do not change ownership.
function(opentlv_add_module_test name)
    cmake_parse_arguments(T "" "OWNER" "SOURCES;DEPENDENCIES" ${ARGN})
    get_property(owner GLOBAL PROPERTY OPENTLV_MODULE_${T_OWNER})
    if(NOT owner OR T_UNPARSED_ARGUMENTS OR NOT T_SOURCES)
        message(FATAL_ERROR "Test ${name}: declare a registered OWNER and SOURCES")
    endif()
    foreach(source IN LISTS T_SOURCES)
        get_filename_component(source "${source}" ABSOLUTE)
        string(SHA256 source_id "${source}")
        get_property(previous GLOBAL PROPERTY OPENTLV_TEST_${source_id})
        if(previous)
            message(FATAL_ERROR "Test source ${source} already belongs to ${previous}")
        endif()
        set_property(GLOBAL PROPERTY OPENTLV_TEST_${source_id} "${T_OWNER}")
    endforeach()
    add_executable(${name} ${T_SOURCES})
    target_link_libraries(${name} PRIVATE ${owner})
    foreach(dep IN LISTS T_DEPENDENCIES)
        get_property(dependency GLOBAL PROPERTY OPENTLV_MODULE_${dep})
        if(NOT dependency)
            message(FATAL_ERROR "Test ${name}: unknown dependency ${dep}")
        endif()
        target_link_libraries(${name} PRIVATE ${dependency})
    endforeach()
    if(NOT TARGET test-module-${T_OWNER})
        add_custom_target(test-module-${T_OWNER})
    endif()
    add_dependencies(test-module-${T_OWNER} ${name})
    add_test(NAME ${name} COMMAND ${name})
    set_tests_properties(${name} PROPERTIES LABELS "module;module:${T_OWNER}")
endfunction()
