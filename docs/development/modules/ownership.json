  "resolutions": {
    "core-copy-element": {"issue": 647, "summary": "Move Writer-based tlv_copy_element() from Core copy.h/copy.c to IO; Core keeps tlv_copy_value() and tlv_copy_encoded(), which Writer already uses. Removes the Core <-> IO cycle."},
    "core-utf8-api": {"issue": 647, "summary": "Publish the UTF-8 validation helpers from utf8_internal.h as a documented Core fundamental utility so IO, Query, Codec and builtins stop including a Core private header."},
    "core-callback-api": {"issue": 647, "summary": "Publish tlv_callback_result() from callback_internal.h as a documented Core inline callback-result contract used by Format, Writer, Codec, Query and builtin providers."},
    "core-diagnostic-causes": {"issue": 647, "summary": "Add the generic cause-frame and diagnostic-domain infrastructure to Core (docs/development/modules/diagnostics.md) before any module drops its foreign detail union."},
    "io-diagnostic-names": {"issue": 647, "summary": "Move tlv_reader_operation_string() and tlv_writer_operation_string() from Core diagnostic_strings.c to IO."},
    "io-tree-measure": {"issue": 647, "summary": "Publish the observed Tree Writer event measurement used by Document Query editing as an IO API instead of the private writer/tree_internal.h declaration."},
    "document-query-boundary": {"issue": 648, "summary": "Move the Document Query declarations, types and Query-specific node edit helpers out of the Document target into the Query-owned query-document integration; Document exposes the public node traversal and edit boundary that the integration needs."},
    "document-codec-facade": {"issue": 648, "summary": "Move typed decoding of Document nodes (document.hpp decode()/get()) into a header-only document-codec integration so the Document facade needs no Codec headers."},
    "query-document-integration": {"issue": 650, "summary": "Register query/document_path.c and query/document_backend.c as the Query-owned integration. They use the public Document boundary from #648; Query internals they call become the Query owner-internal interface exported only to Query integrations."},
    "query-codec-hooks": {"issue": 650, "summary": "Query conversion hooks and tlv_query_diagnostic_t report conversion failures through Core cause frames; codec-specific adapters, builtin hooks and the C++ hook options move to query-codec, and tlv_query_definition_resolve() stays in Query.", "requires": ["core-diagnostic-causes"]},
    "query-diagnostic-names": {"issue": 650, "summary": "Move tlv_query_error_kind_string() and tlv_query_cause_string() from Core diagnostic_strings.c to Query."},
    "codec-diagnostic-vocabulary": {"issue": 651, "summary": "Move tlv_codec_diagnostic_init() and the Codec name functions from Core diagnostic.c/diagnostic_strings.c to Codec; tlv_codec_detail_t drops its Reader/Schema union and Structure Codec attaches those causes as cause frames.", "requires": ["core-diagnostic-causes"]},
    "io-codec-facade": {"issue": 651, "summary": "Move the typed writer_base::write() overloads from tlv++/codec/typed.hpp into a header-only io-codec integration so the Codec facade needs no IO headers."},
    "schema-diagnostic-causes": {"issue": 652, "summary": "tlv_schema_diagnostic_t drops its Codec detail member and receives conversion causes as cause frames; Schema name functions move from Core diagnostic_strings.c to Schema; the C++ error type keeps Schema accessors in the Schema facade.", "requires": ["core-diagnostic-causes"]},
    "schema-number-api": {"issue": 652, "summary": "EMV uses the public schema-number API instead of including schema/codec_internal.h."},
    "schema-query-integration": {"issue": 652, "summary": "Schema Query uses public Query execution APIs instead of query/program_internal.h, and tlv_schema_query_validate_document() moves to the schema-query-document integration."},
    "remove-module-selection": {"issue": 654, "summary": "Remove the module-selection options and their tlv_config_* runtime mirrors; module presence is a link-time fact."},
    "query-features": {"issue": 650, "summary": "Keep OPENTLV_QUERY_FRONTEND and OPENTLV_QUERY_SET_OPERATIONS as Query-internal options with Query-owned macros and runtime mirrors."}
  },
