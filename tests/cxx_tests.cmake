cmake_minimum_required(VERSION 3.16)

set(test_target test-${test_group}-tlvpp)

set(HEADERS
)

set(SOURCES
    test_tlvpp.cpp
)

if(test_group STREQUAL "unit")
    list(APPEND SOURCES public_api_test.cpp)
    list(APPEND SOURCES test_native_boundary.cpp test_semantic_views.cpp codec/test_typed_fields.cpp)
    # Builtin Formats are fixtures; Generator owns all existing C/C++ scenarios.
    opentlv_add_module_test(test-generator OWNER generator SOURCES generator_test.cpp)
    target_link_libraries(test-generator PRIVATE OpenTLV::Core OpenTLV::IO OpenTLV::Generator OpenTLV::ASN1 OpenTLV::EMV OpenTLV::NFC OpenTLV::Bluetooth OpenTLV::DHCP GTest::gtest_main)
    opentlv_configure_compiler(test-generator)
    opentlv_copy_shared_runtime(test-generator)
    set_tests_properties(test-generator PROPERTIES LABELS "unit;module:generator")
    list(APPEND SOURCES test_diagnostic.cpp builtins/test_convenience.cpp)
    add_executable(test-builtin-convenience-smoke builtins/convenience_smoke.cpp)
    target_link_libraries(test-builtin-convenience-smoke PRIVATE OpenTLV::Core OpenTLV::IO OpenTLV::ASN1 OpenTLV::EMV OpenTLV::Bluetooth OpenTLV::NFC OpenTLV::DHCP OpenTLV::LLDP)
    set_target_properties(test-builtin-convenience-smoke PROPERTIES CXX_STANDARD 11 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)
    target_compile_options(test-builtin-convenience-smoke PRIVATE
        "$<$<CXX_COMPILER_ID:GNU,Clang>:-fno-elide-constructors>")
    opentlv_configure_compiler(test-builtin-convenience-smoke)
    opentlv_copy_shared_runtime(test-builtin-convenience-smoke)
    add_test(NAME Unit_Tlvpp_BuiltinConvenience_AllocationAndNamespaces COMMAND test-builtin-convenience-smoke)
    set_tests_properties(Unit_Tlvpp_BuiltinConvenience_AllocationAndNamespaces PROPERTIES LABELS "unit")
    list(APPEND SOURCES reader/test_reader.cpp)
    list(APPEND SOURCES reader/test_iterable_reader.cpp)
    list(APPEND SOURCES query/test_query_ranges.cpp)
    add_executable(test-reader-iteration-smoke reader/iteration_smoke.cpp)
    target_include_directories(test-reader-iteration-smoke PRIVATE ${OpenTLV_SOURCE_DIR}/tests)
    target_link_libraries(test-reader-iteration-smoke PRIVATE OpenTLV::Core OpenTLV::IO OpenTLV::ASN1 OpenTLV::EMV OpenTLV::Bluetooth OpenTLV::NFC)
    set_target_properties(test-reader-iteration-smoke PROPERTIES CXX_STANDARD 11 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)
    target_compile_options(test-reader-iteration-smoke PRIVATE
        "$<$<CXX_COMPILER_ID:GNU,Clang>:-fno-elide-constructors>")
    opentlv_configure_compiler(test-reader-iteration-smoke)
    opentlv_copy_shared_runtime(test-reader-iteration-smoke)
    add_test(NAME Unit_Tlvpp_IterableReader_AllocationAndMoves COMMAND test-reader-iteration-smoke)
    set_tests_properties(Unit_Tlvpp_IterableReader_AllocationAndMoves PROPERTIES LABELS "unit")
    list(APPEND SOURCES writer/test_tree_writer.cpp writer/test_builder.cpp)
    add_executable(test-writer-builder-smoke writer/builder_smoke.cpp)
    target_include_directories(test-writer-builder-smoke PRIVATE ${OpenTLV_SOURCE_DIR}/tests)
    target_link_libraries(test-writer-builder-smoke PRIVATE OpenTLV::Core OpenTLV::IO OpenTLV::ASN1)
    set_target_properties(test-writer-builder-smoke PROPERTIES CXX_STANDARD 11 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)
    target_compile_options(test-writer-builder-smoke PRIVATE
        "$<$<CXX_COMPILER_ID:GNU,Clang>:-fno-elide-constructors>")
    opentlv_configure_compiler(test-writer-builder-smoke)
    opentlv_copy_shared_runtime(test-writer-builder-smoke)
    add_test(NAME Unit_Tlvpp_WriterBuilder_AllocationAndMoves COMMAND test-writer-builder-smoke)
    set_tests_properties(Unit_Tlvpp_WriterBuilder_AllocationAndMoves PROPERTIES LABELS "unit")
    # tlv::fixed_format<> now delegates to tlv_fixed_format_init(), so its
    # tests use the fixed-format implementation in Core.
    list(APPEND SOURCES formats/test_fixed_format.cpp formats/test_custom_format.cpp)
    list(APPEND SOURCES document/test_document.cpp)
    add_executable(test-document-handle-smoke document/handle_smoke.cpp)
    target_link_libraries(test-document-handle-smoke PRIVATE OpenTLV::Core OpenTLV::IO OpenTLV::Document OpenTLV::Query OpenTLV::QueryDocument OpenTLV::ASN1)
    set_target_properties(test-document-handle-smoke PROPERTIES CXX_STANDARD 11 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)
    opentlv_configure_compiler(test-document-handle-smoke)
    opentlv_copy_shared_runtime(test-document-handle-smoke)
    add_test(NAME Unit_Tlvpp_Document_AllocationAndHandles COMMAND test-document-handle-smoke)
    set_tests_properties(Unit_Tlvpp_Document_AllocationAndHandles PROPERTIES LABELS "unit")
endif()

if(test_group STREQUAL "integration")
    list(APPEND SOURCES layers_test.cpp)
    list(APPEND SOURCES builtins/nfc/type2_cpp_test.cpp)
    list(APPEND SOURCES builtins/dhcp/dhcpv4_cpp_test.cpp)
endif()

# Runtime text scenarios belong to the Query frontend feature.
if(NOT OPENTLV_QUERY_FRONTEND)
    list(FILTER SOURCES EXCLUDE REGEX "^query/")
endif()

set(fixture_dependencies_core io document query query-document query-codec codec io-codec document-codec schema asn1 bluetooth emv nfc dhcp lldp)
set(fixture_dependencies_io core document query query-document codec codec-structure schema asn1 emv bluetooth nfc dhcp lldp)
set(fixture_dependencies_document core io query query-document codec document-codec asn1)
set(fixture_dependencies_query core io document query-document codec codec-structure query-codec schema schema-query-document asn1 emv)
set(fixture_dependencies_query-document core io document query codec query-codec asn1)
set(fixture_dependencies_codec core io io-codec document document-codec)
set(fixture_dependencies_asn1 core io emv bluetooth nfc dhcp lldp)
set(fixture_dependencies_nfc core io document query query-document)
set(fixture_dependencies_dhcp core io document query query-document)

# Preserve every scenario while assigning each source to one functional owner.
foreach(owner IN ITEMS core io document query query-document codec asn1 nfc dhcp)
    set(owned_sources)
    foreach(source IN LISTS SOURCES)
        set(source_owner core)
        if(source MATCHES "^(reader/|writer/|copy_test|architecture_test|layers_test|test_tlvpp|test_diagnostic|transformed_tag|formats/.*io_test|formats/test_custom_format)")
            set(source_owner io)
        elseif(source MATCHES "^document/")
            set(source_owner document)
        elseif(source MATCHES "^query/f3")
            set(source_owner query-document)
        elseif(source MATCHES "^query/")
            set(source_owner query)
        elseif(source MATCHES "^codec/")
            set(source_owner codec)
        elseif(source MATCHES "^builtins/nfc/")
            set(source_owner nfc)
        elseif(source MATCHES "^builtins/dhcp/")
            set(source_owner dhcp)
        elseif(source MATCHES "^builtins/")
            set(source_owner asn1)
        endif()
        if(source_owner STREQUAL owner)
            list(APPEND owned_sources ${source})
        endif()
    endforeach()
    if(NOT owned_sources)
        continue()
    endif()
    set(owned_target ${test_target}-${owner})
    opentlv_add_module_test(${owned_target} OWNER ${owner} SOURCES ${owned_sources}
        DEPENDENCIES ${fixture_dependencies_${owner}})
    target_include_directories(${owned_target} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${OpenTLV_SOURCE_DIR}/tests)
    target_link_libraries(${owned_target} PRIVATE GTest::gtest_main)
    opentlv_configure_compiler(${owned_target})
    opentlv_copy_shared_runtime(${owned_target})
    set_tests_properties(${owned_target} PROPERTIES LABELS "${test_group};module:${owner}")
endforeach()
